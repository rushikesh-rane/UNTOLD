# --- Required ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# NEVER put a service_role key in any variable that starts with NEXT_PUBLIC_ (those are sent to every visitor).

# --- Recommended for production ---------------------------------------------------------------------------
# Shared rate limiting for the /api routes (free at https://upstash.com). Without these the limiter still works,
# but each server instance counts on its own, so on serverless hosting it is only a speed bump.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CAPTCHA on sign-in and sign-up (free at https://dash.cloudflare.com -> Turnstile). Put the SITE key here, then
# switch CAPTCHA on in Supabase (Authentication -> Attack Protection) with the SECRET key.
# Do these two steps together, or sign-in will stop working.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional ---------------------------------------------------------------------------------------------
# Set to true to make the Content-Security-Policy only REPORT problems in the browser console instead of blocking.
# Useful for diagnosing a blocked image or script. Remove it again afterwards.
CSP_REPORT_ONLY=false

# --- Local development only. These are ignored in production builds. --------------------------------------
UNTOLD_LOCAL_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=false
